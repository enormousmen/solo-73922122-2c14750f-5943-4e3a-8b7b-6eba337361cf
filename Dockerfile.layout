# Builds the demo OCI layout into the named volume `oci-layout`, then exits.
# Everything else in the stack only reads from that volume, except the API's
# own state volume.
FROM python:3.11-slim

WORKDIR /srv
COPY scripts ./scripts

# `--shared` makes amd64 and arm64 v1/v2/v3 images share one byte-identical
# resource layer per version, which is what the scan-coalescing demo measures.
# The amd64-specific layer is deliberately much larger than arm64's so the
# existing concurrency demo still shows a slow amd64 scan and a fast arm64 one.
CMD ["python", "scripts/build_layout.py", \
     "--shared", \
     "--out", "/oci-layout", \
     "--meta", "/oci-layout/demo-digests.json", \
     "--shared-payload-bytes", "4194304", \
     "--amd64-payload-bytes", "8388608", \
     "--arm64-payload-bytes", "8192"]
